# Copie para .env e ajuste se necessário: cp .env.example .env
# Estes valores são de DESENVOLVIMENTO. Nunca versione credenciais reais.

APP_NAME=decada
APP_ENV=dev
CONSENT_VERSION=v1

# Assina os tokens de acesso. Gere uma chave própria em produção:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=chave-de-desenvolvimento-nao-use-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Despensa por foto (opcional): chave da API do Claude. Sem ela, só a foto fica
# indisponível. Nunca versione a chave — o .env não entra no git.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-5-5

POSTGRES_USER=decada
POSTGRES_PASSWORD=decada
POSTGRES_DB=decada
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- docker compose up --build (banco + API + app) ---
# IP da sua máquina na rede local; o celular usa para alcançar a API e o Metro.
# Linux: hostname -I | awk '{print $1}'
HOST_IP=192.168.0.10
API_PORT=8000
# Opcional (só dev): 1 = o app abre sempre na tela de login, sem apagar nada do banco.
RESET_SESSION=0
